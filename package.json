{
  "name": "nearbytes-chat",
  "version": "0.1.0",
  "description": "Nearbytes hub-scoped chat protocol on top of the event log",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "prepack": "tsc",
    "refresh": "node scripts/refresh.mjs",
    "update": "node scripts/update.mjs",
    "test": "tsc && node --test test/*.test.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "nearbytes-crypto": "https://github.com/nearbytes/nearbytes-crypto.git#commit=9b2c1936589d2d8b049f0ca39e76513eba4ded9a",
    "nearbytes-log": "https://github.com/nearbytes/nearbytes-log.git#commit=31fb75e3877ef762566216a0ceace294329d6295"
  },
  "devDependencies": {
    "typescript": "^5.3.2"
  },
  "packageManager": "yarn@4.15.0"
}
